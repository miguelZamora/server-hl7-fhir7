erDiagram
    subscription ||--o{ sub_identifier : "0..*"
    subscription ||--o{ sub_contact : "0..*"
    subscription ||--o{ sub_filter_by : "0..*"
    subscription ||--o{ sub_parameter : "0..*"

    subscription {
        bigint id PK
        text fhir_id
        text status
        text topic
        text endpoint
        text content
    }

    sub_filter_by {
        bigint id PK
        bigint subscription_id FK
        text resource_type
        text filter_parameter
        text comparator
        text modifier
        text value
    }