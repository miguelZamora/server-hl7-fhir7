    practitioner {
        bigint id PK
        text fhir_id
        boolean active
        text gender
        date birth_date
    }

    prac_qualification {
        bigint id PK
        bigint practitioner_id FK
        bigint code_coding_id FK
        text code_text
        text issuer_reference
    }