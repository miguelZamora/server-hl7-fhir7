    value_set {
        bigint id PK
        text fhir_id
        text url
        text version
        text name
        text status
    }

    vs_compose {
        bigint id PK
        bigint value_set_id FK
        date locked_date
        boolean inactive
    }

    vs_expansion {
        bigint id PK
        bigint value_set_id FK
        timestamptz timestamp
        int total
    }

    vs_expansion_contains {
        bigint id PK
        bigint expansion_id FK
        bigint parent_id FK
        text code
        text display
