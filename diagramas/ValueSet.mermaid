    value_set ||--o| vs_expansion : "0..1"

    vs_compose ||--o{ vs_compose_include : "1..*"
    vs_compose ||--o{ vs_compose_exclude : "0..*"
    vs_compose ||--o{ vs_compose_property : "0..*"

    vs_compose_include ||--o{ vs_compose_include_concept : "0..*"
    vs_compose_include ||--o{ vs_compose_include_filter : "0..*"
    vs_compose_include ||--o{ vs_compose_include_valueset : "0..*"

    vs_compose_include_concept ||--o{ vs_compose_include_concept_designation : "0..*"
    vs_compose_include_concept_designation ||--o{ vs_compose_include_concept_designation_additional_use : "0..*"

    vs_expansion ||--o{ vs_expansion_parameter : "0..*"
